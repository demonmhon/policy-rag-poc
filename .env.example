# PostgreSQL Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=policy_rag

# AI Provider Mode: 'mock' (works out-of-the-box without API keys), 'gemini', or 'openai'
AI_PROVIDER=mock

# API Keys (Required if AI_PROVIDER is 'gemini' or 'openai')
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
