# PostgreSQL Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=policy_rag

# AI Provider Mode: 'mock' (works out-of-the-box without API keys), 'gemini', 'openai', or 'claude'
AI_PROVIDER=mock

# Optional Embedding Provider Override: 'mock' | 'gemini' | 'openai'
# (When AI_PROVIDER=claude, embeddings automatically use EMBEDDING_PROVIDER or available Gemini/OpenAI keys, or 'mock')
EMBEDDING_PROVIDER=

# API Keys (Required if AI_PROVIDER is 'gemini', 'openai', or 'claude')
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Model & Threshold Overrides
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-haiku-latest
EMBEDDING_DIMENSION=768
MIN_SIMILARITY_THRESHOLD=0.16
