{
  "info": {
    "_postman_id": "b7c42d90-9f18-4d62-84c3-5f20b819e301",
    "name": "Bank Company Policy Assistant RAG Microservices",
    "description": "Import-ready Postman collection for testing the Thai Bank Policy Assistant RAG Microservices (Ingestion Service on Port 3001 & Query Service on Port 3002).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "ingestionBaseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "queryBaseUrl",
      "value": "http://localhost:3002"
    }
  ],
  "item": [
    {
      "name": "1. Health Checks",
      "item": [
        {
          "name": "Ingestion Service Health (3001)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ingestionBaseUrl}}/health"
          }
        },
        {
          "name": "Query Service Health (3002)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{queryBaseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "2. Corpus Management (Ingestion Service)",
      "item": [
        {
          "name": "Seed All 16 Thai Bank Policies (.md & .pdf)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{ingestionBaseUrl}}/api/v1/documents/seed"
          }
        },
        {
          "name": "List All Indexed Policy Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ingestionBaseUrl}}/api/v1/documents"
          }
        },
        {
          "name": "Ingest Policy via JSON Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"นโยบายการอบรมจริยธรรมทางธุรกิจประจำปี (COMP-POL-2026-99)\",\n  \"department\": \"Compliance\",\n  \"version\": \"2026.1\",\n  \"content\": \"พนักงานธนาคารทุกระดับต้องเข้ารับการอบรมและทำแบบทดสอบด้านจริยธรรมทางธุรกิจและการต่อต้านการฟอกเงินอย่างน้อยปีละ 1 ครั้ง โดยต้องได้คะแนนสอบไม่ต่ำกว่า 80 เปอร์เซ็นต์\"\n}"
            },
            "url": "{{ingestionBaseUrl}}/api/v1/documents/text"
          }
        },
        {
          "name": "Upload Policy File (.md / .txt / .pdf)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample-policies/15_gifts_entertainment_anti_bribery.pdf"
                },
                {
                  "key": "department",
                  "value": "Compliance",
                  "type": "text"
                }
              ]
            },
            "url": "{{ingestionBaseUrl}}/api/v1/documents/upload"
          }
        }
      ]
    },
    {
      "name": "3. Grounded Policy Queries (POST /ask)",
      "item": [
        {
          "name": "Compliance — KYC/CDD & EDD Thresholds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"ลูกค้าความเสี่ยงสูงต้องทบทวนข้อมูล CDD ทุกกี่ปี และฝากเงินเท่าไหร่ต้องทำ EDD?\",\n  \"department\": \"Compliance\",\n  \"topK\": 3\n}"
            },
            "url": "{{queryBaseUrl}}/ask"
          }
        },
        {
          "name": "Operations — Wire Transfer Dual Control (Maker-Checker)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"การโอนเงินเกินวงเงินเท่าไหร่ต้องใช้ระบบคู่ตรวจสอบ Maker-Checker?\",\n  \"department\": \"Operations\",\n  \"topK\": 3\n}"
            },
            "url": "{{queryBaseUrl}}/ask"
          }
        },
        {
          "name": "IT — Public Generative AI & ChatGPT Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"พนักงานสามารถนำข้อมูลลูกค้าหรือ Source Code ไปป้อนใน ChatGPT หรือ Generative AI สาธารณะได้หรือไม่?\",\n  \"department\": \"IT\",\n  \"topK\": 3\n}"
            },
            "url": "{{queryBaseUrl}}/ask"
          }
        },
        {
          "name": "HR — Mandatory Block Leave Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"การลาหยุดต่อเนื่องภาคบังคับ (Mandatory Block Leave) ต้องลากี่วันทำการติดต่อกัน?\",\n  \"department\": \"HR\",\n  \"topK\": 3\n}"
            },
            "url": "{{queryBaseUrl}}/ask"
          }
        },
        {
          "name": "PDF Policy — Anti-Bribery & Gift Limit (3,000 THB)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"การรับของขวัญตามเทศกาลกำหนดเพดานมูลค่าไม่เกินกี่บาท และต้องขึ้นทะเบียนภายในกี่วัน?\",\n  \"topK\": 3\n}"
            },
            "url": "{{queryBaseUrl}}/ask"
          }
        }
      ]
    },
    {
      "name": "4. Banking Guardrails & Validation Tests",
      "item": [
        {
          "name": "Guardrail 1 — PII Redaction (Thai ID, Phone, Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"ผมเลขบัตร 1-1001-00123-45-6 โทร 081-234-5678 อีเมล somchai@bank.co.th สวัสดิการค่าทันตกรรมเบิกได้ปีละกี่บาท?\",\n  \"topK\": 3\n}"
            },
            "url": "{{queryBaseUrl}}/ask"
