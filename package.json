{
  "name": "policy-rag-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "Bank Company Policy Assistant RAG Microservices (TypeScript)",
  "scripts": {
    "format": "prettier --write \"services/**/*.ts\" \"scripts/**/*.ts\" \"*.json\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"services/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "pnpm --dir services/ingestion-service test && pnpm --dir services/query-service test",
    "eval": "tsx eval/run-eval.ts",
    "generate:pdfs": "tsx scripts/generate-sample-pdfs.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
